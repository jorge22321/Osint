CLARIFAI_PAT=
CLARIFAI_BASE_URL=
CLARIFAI_MODEL_ID=
BREACH_DIRECTORY_KEY=
OPENAI_API_KEY=your-openai-key
MISTRAL_API_KEY=your-mistral-key
GMAIL_USER=
GMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
